# TelePost web app environment variables.
# Copy to .env.local for local development.

# API base URL of the Cloudflare Worker.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Show the local-only "Dev login" button on /login. The worker must run
# with ENVIRONMENT != production (its default in wrangler.toml).
NEXT_PUBLIC_DEV_LOGIN=true

# Real Telegram Login Widget: bot username from BotFather WITHOUT the @.
# The widget only works on domains registered via BotFather /setdomain —
# not localhost. Use a tunnel or your deployed domain for real logins.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=panditfxbot